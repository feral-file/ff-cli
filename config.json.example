{
  "defaultDuration": 10,
  "generativeDuration": 60,
  "browser": {
    "timeout": 90000,
    "sanitizationLevel": "medium"
  },
  "feedServers": [
    {
      "baseUrl": "https://dp1-feed-operator-api-prod.autonomy-system.workers.dev/api/v1"
